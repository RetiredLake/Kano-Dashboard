                "connectCopy": "Connect it beneath your create block.",
                "connectTo": {
                    "id": "block_0",
                    "rawId": "sRke;HWqQcex,]isU!GR"
                }
            },
            {
                "banner": {
                    "text":"Change Y to <kano-value-preview><span>5</span></kano-value-preview> so the block is above your pyramid."
                },
                "beacon": {
                    "target": {
                        "block": {
                            "shadow": {
                                "name": "POSITION",
                                "shadow": "Y"
                            },
                            "id": "block_1"
                        }
                    }
                },
                "validation": {
                    "blockly": {
                        "value": {
                            "target": {
                                "shadow": {
                                    "name": "POSITION",
                                    "shadow": "Y"
