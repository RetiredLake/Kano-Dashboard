            },
            {
                "banner": {
                    "text":"Change **cube** to **pyramid**."
                },
                "beacon": {
                    "target": {
                        "block": {
                            "inputName": "SHAPE",
                            "id": "block_0"
                        }
                    }
                },
                "validation": {
                    "blockly": {
                        "value": {
