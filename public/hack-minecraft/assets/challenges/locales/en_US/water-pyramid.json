                    }
                }
            },
            {
                "type": "create-block",
                "category": "craft",
                "blockType": "minecraft_set_block",
                "alias": "block_1",
                "openFlyoutCopy": "And it has a built in waterfall. Let's add some water, open the Craft tray.",
