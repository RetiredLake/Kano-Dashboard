                    }
                }
            },
            {
                "banner": {
                    "text":"This is a special pyramid, it's completely transparent. Change Type to <i class=\"blocks-sprite blocks-sprite-glass\"></i>."
                },
                "beacon": {
                    "target": {
                        "block": {
                            "shadow": "TYPE",
                            "id": "block_0"
                        }
                    }
                },
                "validation": {
                    "blockly": {
                        "value": {
                            "target": {
                                "shadow": "TYPE",
