            {
                "banner": {
                    "text": "Now hit Tab and become a power pharaoh!"
                },
                "validation": {
                    "mode-change": "play"
                }
            },
            {
                "minecraft_chat": "Hit the ${default_power.keyLabel} key to use your new power",
                "validation": {
                    "power-triggered": "default_power"
                }
            },
            {
                "minecraft_chat": "Sweet pyramid! Use your sword if you need to escape",
                "validation": {
                    "wait": 10000
