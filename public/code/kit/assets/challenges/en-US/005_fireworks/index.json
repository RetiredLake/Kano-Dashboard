{
    "steps": [
       {
           "banner": {
               "text": "Use Particles to set off fireworks with the coding wand",
               "next_button": true
           },
           "beacon": {
               "target": "banner-button",
               "offset": 0
           }
       },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Events tray",
            "grabBlockCopy": "Use this block to run code when you wave the coding wand. Drag it onto your code space",
            "category": "events",
            "blockType": "events_onFlick",
            "alias": "block_0",
            "dropCopy": "Drop anywhere in the code space"
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "TYPE",
                "id": "block_0"
            },
            "bannerCopy": "Change <kano-value-preview>Up</kano-value-preview> to <kano-value-preview>Left</kano-value-preview>",
            "value": "left"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Particles tray",
            "grabBlockCopy": "This block creates an explosion of Particles. Drag it onto your code space",
            "category": "particle",
            "blockType": "particle_bang",
            "alias": "block_1",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "CALLBACK",
                "id": "block_0"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "X",
                "shadow": {
                    "name": "POSITION",
                    "shadow": "X"
                },
                "id": "block_1"
            },
            "bannerCopy": "Change <kano-value-preview><span>400</span></kano-value-preview> to <kano-value-preview><span>200</span></kano-value-preview> to move the explosion to the left",
            "value": "200"
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "COLOR",
                "shadow": "COLOR",
                "id": "block_1"
            },
            "bannerCopy": "Change <kano-value-preview><span>#000000</span></kano-value-preview> to <kano-value-preview><span>#FFEB3C</span></kano-value-preview> for some yellow particles"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Wand tray",
            "grabBlockCopy": "Let's light up the coding wand's LED to match the fireworks. Drag the block onto your code space",
            "category": "wand",
            "blockType": "wand_setLed",
            "alias": "block_2",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_1"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "COLOR",
                "shadow": "COLOR",
                "id": "block_2"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>#ffffff</span></kano-value-preview>\" to \"<kano-value-preview><span>#ffee58</span></kano-value-preview>\""
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Wand tray",
            "grabBlockCopy": "This block will make your coding wand rumble. Drag it to your code space",
            "category": "wand",
            "blockType": "wand_vibrate",
            "alias": "block_3",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_2"
            }
        },
        {
            "banner": {
                "text": "Wave your coding wand left to set off a firework. Now, add another firework",
                "next_button": true
            },
            "beacon": {
                "target": "banner-button",
                "offset": 0
            }
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Events tray",
            "grabBlockCopy": "Use this block again. Drag it onto your code space",
            "category": "events",
            "blockType": "events_onFlick",
            "alias": "block_4",
            "dropCopy": "Drop it anywhere in the code space"
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "TYPE",
                "id": "block_4"
            },
            "bannerCopy": "Change <kano-value-preview>Up</kano-value-preview> to <kano-value-preview>Right</kano-value-preview> so the code runs when the coding wand is waved to the right",
            "value": "right"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Particle tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "particle",
            "blockType": "particle_bang",
            "alias": "block_5",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "CALLBACK",
                "id": "block_4"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "X",
                "shadow": {
                    "name": "POSITION",
                    "shadow": "X"
                },
                "id": "block_5"
            },
            "bannerCopy": "Change <kano-value-preview><span>400</span></kano-value-preview> to <kano-value-preview><span>600</span></kano-value-preview>",
            "value": "600"
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "COLOR",
                "shadow": "COLOR",
                "id": "block_5"
            },
            "bannerCopy": "Change <kano-value-preview><span>#000000</span></kano-value-preview> to <kano-value-preview><span>#E91E64</span></kano-value-preview>"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Wand tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "wand",
            "blockType": "wand_setLed",
            "alias": "block_6",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_5"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "COLOR",
                "shadow": "COLOR",
                "id": "block_6"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>#ffffff</span></kano-value-preview>\" to \"<kano-value-preview><span>#f06292</span></kano-value-preview>\""
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Wand tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "wand",
            "blockType": "wand_vibrate",
            "alias": "block_7",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_6"
            }
        },
        {
            "banner": {
                "text": "**Wave your coding wand quickly to the left and right** to set off fireworks",
                "next_button": true
            },
            "beacon": {
                "target": "banner-button",
                "offset": 0
            }
        }
    ],
    "parts": [],
    "modules": [
        "events",
        "particle",
        "wand"
    ],
    "variables": [],
