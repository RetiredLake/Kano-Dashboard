        ]
    },
    "mode": "wand",
    "id": "060_mandrake",
    "defaultApp": "{\"source\":\"<xml xmlns=\\\"http://www.w3.org/1999/xhtml\\\"></xml>\",\"scene\":\"greenhouse\"}"
