{
    "steps": [
        {
            "banner": {
                "text": "Let's code a screeching Mandrake that gets louder as you point your coding wand towards it",
                "next_button": true
            }
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Events tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "events",
            "blockType": "events_onAppStart",
            "alias": "block_1",
            "dropCopy": "Drop this block anywhere in your code space"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Add the Mandrake by openining the Objects tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "objects",
            "blockType": "objects_add",
            "alias": "block_2",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "CALLBACK",
                "id": "block_1"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "ID",
                "id": "block_2"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>Owl</span></kano-value-preview>\" to \"<kano-value-preview><span>Mandrake</span></kano-value-preview>\"",
            "value": "Mandrake"
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "NAME",
                "id": "block_2"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>Owl</span></kano-value-preview>\" to \"<kano-value-preview><span>Mandrake</span></kano-value-preview>\"",
            "value": "Mandrake"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Let's make the Mandrake wriggle around every second. Open the Control tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "control",
            "blockType": "every_x_seconds",
            "alias": "block_3",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_2"
            }
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Now set the movement by applying force. Open the Physics tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "position",
            "blockType": "position_applyForce",
            "alias": "block_4",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "DO",
                "id": "block_3"
            }
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Math tray to grab a random number block",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "math",
            "blockType": "math_random",
            "alias": "block_5",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "ANGLE",
                "id": "block_4"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "MIN",
                "shadow": "MIN",
                "id": "block_5"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>0</span></kano-value-preview>\" to \"<kano-value-preview><span>-20</span></kano-value-preview>\"",
            "value": "-20"
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "MAX",
                "shadow": "MAX",
                "id": "block_5"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>10</span></kano-value-preview>\" to \"<kano-value-preview><span>20</span></kano-value-preview>\"",
            "value": "20"
        },
        {
            "banner": {
                "text": "Minus numbers will move it to the left and positive numbers will move it to the right",
                "next_button": true
                },
                "beacon": {
                   "target": "banner-button",
                   "offset": 0
                }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "FORCE",
                "shadow": "FORCE",
                "id": "block_4"
            },
            "bannerCopy": "Now you need to add some more force to make the Mandrake move. Change \"<kano-value-preview><span>0</span></kano-value-preview>\" to \"<kano-value-preview><span>100</span></kano-value-preview>\"",
            "value": "100"
        },
        {
            "type": "create-part",
            "part": "speaker",
            "alias": "part_0",
            "openPartsCopy": "We want the Mandrake to scream so we need to add a **Speaker** part, use the Add Parts button",
            "addPartCopy": "Select the **Speaker** part to add it to your app"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Speaker tray to get a block that will loop a sound from the speaker",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": {
                "part": "part_0"
            },
            "blockType": {
                "part": "part_0",
                "type": "speaker_loop"
            },
            "alias": "block_6",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_3"
            }
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Speaker tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": {
                "part": "part_0"
            },
            "blockType": {
                "part": "part_0",
                "type": "speaker_sample"
            },
            "alias": "block_7",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "SAMPLE",
                "id": "block_6"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "SET",
                "id": "block_7"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>Wand</span></kano-value-preview>\" to \"<kano-value-preview><span>Creatures</span></kano-value-preview>\"",
            "value": "Creatures"
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "SAMPLE",
                "id": "block_7"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>Acromantula Big</span></kano-value-preview>\" to \"<kano-value-preview><span>Mandrake</span></kano-value-preview>\"",
            "value": "Mandrake"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Now the Mandrake is screaming but we want to control how loud it is using the coding wand. Open the Control tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "control",
            "blockType": "every_x_seconds",
            "alias": "block_8",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_6"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "UNIT",
                "id": "block_8"
            },
            "bannerCopy": "This loop needs to run faster than once per second to keep up with how quickly the wand moves, so change \"<kano-value-preview><span>seconds</span></kano-value-preview>\" to \"<kano-value-preview><span>frames</span></kano-value-preview>\"",
            "value": "frames"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Now we're going to create a variable that stores the coding wand's position. Open the Variables tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "variables",
            "blockType": "variables_set",
            "alias": "block_9",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "DO",
                "id": "block_8"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "VAR",
                "id": "block_9"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>item</span></kano-value-preview>\" to \"<kano-value-preview><span>mandrakeVolume</span></kano-value-preview>\"",
            "value": "mandrakeVolume"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Math tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "math",
            "blockType": "math_arithmetic",
            "alias": "block_10",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "VALUE",
                "id": "block_9"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "OP",
                "id": "block_10"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>+ add</span></kano-value-preview>\" to \"<kano-value-preview><span>÷ divide</span></kano-value-preview>\"",
            "value": "DIVIDE"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Wand tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "wand",
            "blockType": "wand_y",
            "alias": "block_11",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "A",
                "id": "block_10"
            }
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Variables tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "variables",
            "blockType": "math_number",
            "alias": "block_12",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "B",
                "id": "block_10"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "NUM",
                "id": "block_12"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>0</span></kano-value-preview>\" to \"<kano-value-preview><span>6</span></kano-value-preview>\"",
            "value": "6"
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Open the Speaker tray",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": {
                "part": "part_0"
            },
            "blockType": {
                "part": "part_0",
                "type": "speaker_set_volume"
            },
            "alias": "block_13",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "id": "block_9"
            }
        },
        {
            "type": "create-block",
            "openFlyoutCopy": "Now open the Variables tray to connect our new variable mandrakeVolume to the speaker's volume",
            "grabBlockCopy": "Drag the block onto your code space",
            "category": "variables",
            "blockType": "variables_get",
            "alias": "block_14",
            "connectCopy": "Connect to this block",
            "connectTo": {
                "inputName": "VOLUME",
                "id": "block_13"
            }
        },
        {
            "type": "change-input",
            "block": {
                "inputName": "VAR",
                "id": "block_14"
            },
            "bannerCopy": "Change \"<kano-value-preview><span>item</span></kano-value-preview>\" to \"<kano-value-preview><span>mandrakeVolume</span></kano-value-preview>\"",
            "value": "mandrakeVolume"
        },
        {
            "banner": {
                "text": "Now move your coding wand up and down and listen to the Mandrake's screams change",
                "next_button": true
            }
        }

    ],
    "parts": [
        "speaker"
    ],
    "modules": [
        "events",
        "objects",
        "control",
        "position",
        "math",
        "variables",
