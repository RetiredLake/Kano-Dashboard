{"scene":"classroompixies","code":"world.setGravity(0);\nfor (var i = 0; i < 10; i++) {\n  objects.add('Pixie', 'Pixie', position.create(math.random(0, 800), math.random(0, 500)));\n}\ntime.every(1, 'milliseconds', function () {\n  position.launch(objects.get('random'), objects.get('random'), 50);\n  position.launch(objects.get('random'), objects.get('random'), -70);\n});\n\nevents.onFlick('up', function() {\n  objects.stick('pin', objects.get('all'));\n\n});\n","source":"<xml xmlns=\"http://www.w3.org/1999/xhtml\"><variables></variables><block type=\"world_setGravity\" id=\"[;eWNyMf*Jg}6.I?}3Bd\" x=\"68\" y=\"43\"><value name=\"GRAVITY\"><shadow type=\"math_number\" id=\"kz0RWya=YM:U=FyBe-Fi\"><field name=\"NUM\">0</field></shadow></value><next><block type=\"repeat_x_times\" id=\"/_nmcM.w^2=j3fS?vy*F\"><value name=\"N\"><shadow type=\"math_number\" id=\"#[LbMQu@j[dxAJ=1Q;$K\"><field name=\"NUM\">10</field></shadow></value><statement name=\"DO\"><block type=\"objects_add\" id=\"5i5I}dKl:s}ZwUq1L*kj\"><field name=\"ID\">Pixie</field><field name=\"NAME\">Pixie</field><value name=\"POSITION\"><shadow type=\"position_create\" id=\"i9m_Q]iOv$a+ev:mAdvV\"><value name=\"X\"><shadow type=\"math_number\" id=\"5bZ|^D5t5WG]X(X}3Vk:\"><field name=\"NUM\">400</field></shadow><block type=\"math_random\" id=\"=#kf7F[K#PW;7o1?Nmu+\"><value name=\"MIN\"><shadow type=\"math_number\" id=\"o$918uP73@|^mH{LU}KI\"><field name=\"NUM\">0</field></shadow></value><value name=\"MAX\"><shadow type=\"math_number\" id=\"5LA7_*8):s(oXrWa{*Ir\"><field name=\"NUM\">800</field></shadow></value></block></value><value name=\"Y\"><shadow type=\"math_number\" id=\"*X[r+99u?T[zI^1ye`3)\"><field name=\"NUM\">300</field></shadow><block type=\"math_random\" id=\"RP*~[+e1z@PuUuqej}%/\"><value name=\"MIN\"><shadow type=\"math_number\" id=\"yS/hDFGpLy1lSz1NvG8{\"><field name=\"NUM\">0</field></shadow></value><value name=\"MAX\"><shadow type=\"math_number\" id=\"#H|snj6aP/5W9hYXZ*mH\"><field name=\"NUM\">500</f