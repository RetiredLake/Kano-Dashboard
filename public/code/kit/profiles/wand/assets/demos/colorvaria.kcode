{"scene":"owlery","parts": [{ "type": "speaker" }], "code":"var item, color;\n\n\nobjects.add('Owl', 'Owl', position.create(400, 300));\n\nevents.onFlick('up', function() {\n  color = colour.random();\n  objects.setColor(objects.get('all'), color);\n  wand.setLed(color);\n\n});\n","source":"<xml xmlns=\"http://www.w3.org/1999/xhtml\"><variables><variable type=\"\" id=\"Wh$^hQ!?KP/Y=X^O^(TO\">item</variable><variable type=\"\" id=\"!-`7zAIX`NGge~*}{H#S\">color</variable></variables><block type=\"events_onFlick\" id=\"W13n4R{XAY~He*5HxLi:\" x=\"143\" y=\"217\"><field name=\"TYPE\">up</field><statement name=\"CALLBACK\"><block type=\"variables_set\" id=\"J4^+5CA.4pO:5GyTN_L7\"><field name=\"VAR\" id=\"!-`7zAIX`NGge~*}{H#S\" variabletype=\"\">color</field><value name=\"VALUE\"><block type=\"random_colour\" id=\"91QQ}~Z%M`dQEE[a_3_2\"></block></value><next><block type=\"objects_setColor\" id=\"7;UOQ8Z8[Ui1EKjfCk[v\"><value name=\"TINT\"><shadow type=\"objects_get\" id=\"s3H4-#SbU_GhoN-+V!QC\"><field name=\"ID\">all</field></shadow></value><value name=\"TO COLOR\"><shadow type=\"colour_picker\" id=\"ohTrh|y6OBYz2#]aDp^@\"><field name=\"COLOUR\">#ff00ff</field></shadow><block type=\"variables_get\" id=\"Sl!]XAu8iU85+z[6jWTZ\"><field name=\"VAR\" id=\"!-`7zAIX`NGge~*}{H#S\" variabletype=\"\">color</field></block></value><next><block type=\"wand_setLed\" id=\"AdNJjN^LP1jTi|N3u]@p\"><value name=\"COLOR\"><shadow type=\"colour_picker\" id=\"GqtX-:`_:~F+Y!5Y|$RZ\"><field name=\"COLOUR\">#ffffff</field></shadow><block type=\"variables_get\" id=\"iG4KIC^6$+k)n_a$c=?$\"><field name=\"VAR\" id=\"!-`7zAIX`NGge~*}{H#S\" variabletype=\"\">color</field></block></value></block></next></block></next></block></statement></block></xml>","background":"","mode":"wand"}