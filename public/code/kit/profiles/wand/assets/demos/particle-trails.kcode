{"scene":"sandbox","code":"var item, hueCycle;\n\n\nhueCycle = 0;\ntime.every(1, 'frames', function () {\n  hueCycle += 1;\n  particle.setLifespan(3000);\n  particle.setSize(15, 0);\n  particle.setTransparency(100, 40);\n  particle.setColor(colour.create('hsv', hueCycle, 100, 100), '#FFF9C4');\n  particle.setForce(math.random(0, 360), 0.2);\n  particle.generate(position.create(wand.x, wand.y));\n});\ntime.every(1, 'seconds', function () {\n  wand.setLed(colour.create('hsv', hueCycle, 100, 100));\n});\n","source":"<xml xmlns=\"http://www.w3.org/1999/xhtml\"><variables><variable type=\"\" id=\"Ir6$KR0:G7{jAO_[CeT(\">item</variable><variable type=\"\" id=\"s`mLCb?3ibOAoh.:El!)\">hueCycle</variable></variables><block type=\"variables_set\" id=\"DGq==]}PfOhb[gB9!/!1\" x=\"272\" y=\"208\"><field name=\"VAR\" id=\"s`mLCb?3ibOAoh.:El!)\" variabletype=\"\">hueCycle</field><value name=\"VALUE\"><block type=\"math_number\" id=\"rmh_$85fc8ag5(~I.s!B\"><field name=\"NUM\">0</field></block></value><next><block type=\"every_x_seconds\" id=\"QlDtx[ckPWuBPK[YC/uK\"><field name=\"UNIT\">frames</field><value name=\"INTERVAL\"><shadow type=\"math_number\" id=\"fY[MjCY%bE:i;:M=7qWf\"><field name=\"NUM\">1</field></shadow></value><statement name=\"DO\"><block type=\"unary\" id=\"9~p@V7/41~/RE*Z/V(r~\"><field name=\"LEFT_HAND\" id=\"s`mLCb?3ibOAoh.:El!)\" variabletype=\"\">hueCycle</field><field name=\"OPERATOR\">+=</field><value name=\"RIGHT_HAND\"><shadow type=\"math_number\" id=\"6rRsTc]k#=-Qp{_gMFlX\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"particle_setLifespan\" id=\"DMHS0HK_9T4U,S|xR30e\"><value name=\"LIFESPAN\"><shadow type=\"math_number\" id=\"t330xc;N)4hfpA%Q%;w.\"><field name=\"NUM\">3000</field></shadow></value><next><block type=\"particle_setSize\" id=\"IxX*yTX~U*N8-EMgO~uo\"><value name=\"START SIZE\"><shadow type=\"math_number\" id=\"s_$+Q0$gYInca#t~Y$(S\"><field name=\"NUM\">15</field></shadow></value><value name=\"END SIZE\"><shadow type=\"math_n