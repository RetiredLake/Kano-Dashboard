  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "test-wand": "mocha -u tdd --recursive --timeout 30000 profiles/wand/test",
    "test-wand-ci": "mocha -u tdd --recursive --timeout 30000 profiles/wand/test",
    "bundle": "cross-env NODE_OPTIONS='--max-old-space-size=8192' gulp bundle",
    "bundle-shell": "cross-env NODE_OPTIONS='--max-old-space-size=8192' gulp bundle-shell",
    "transpile-shell": "gulp transpile-shell",
    "serve": "node ./packages/shell/bin/cli.js run --root ./",
    "serve-dev": "yarn serve --platform=android",
    "serve-kano": "yarn serve --platform=kano --platform-version=4.0.0",
    "serve-bundle": "node ./packages/shell/bin/cli.js run --root ./dist",
    "transpile": "gulp transpile",
    "thumbnails": "gulp thumbnails",
    "archive": "kart archive ./dist -a releases.kano.me -r .",
    "docs": "esdoc",
    "watch:bundle": "npm-watch bundle",
    "checkstyle": "eslint ./lib ./profiles ./components",
    "checkstyle-ci": "yarn checkstyle -f checkstyle -o eslint.xml",
    "postinstall": "cd packages/shell && yarn"
  },
  "watch": {
    "build-mac-local": {
      "patterns": [
        "lib",
        "profiles",
        "components"
      ],
      "extensions": "js"
    }
  },
